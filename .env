# ================================
# Discord Bot Configuration
# ================================

DISCORD_TOKEN=your_discord_bot_token_here


# ================================
# Minecraft Server Configuration
# ================================

MC_HOST=your.minecraft.server
MC_PORT=25565
MC_USERNAME=your_bot_username


# ================================
# Automatic Bot Shutdown
# ================================
# Set to true to automatically stop the bot at the configured time.
# Set to false to disable automatic shutdown.

AUTO_SHUTDOWN_ENABLED=false

# Time to automatically shut down the bot.
# Uses 24-hour HH:MM format.
# Example: 04:00

AUTO_SHUTDOWN_TIME=04:00


# ================================
# Interleaving
# ================================
# When enabled, the bot periodically disconnects from Minecraft,
# then checks the server's player count and reconnects/waits
# according to the existing empty-server logic.
#
# This is independent from automatic shutdown.

INTERLEAVING_ENABLED=false

# How often the bot should perform an interleaving cycle.
# Value is in hours.
# Example: 3 = approximately every 3 hours.

INTERLEAVING_INTERVAL_HOURS=3
