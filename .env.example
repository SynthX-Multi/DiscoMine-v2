# ─── Discord Bot ───────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_discord_server_id_here

# ─── Minecraft Server ──────────────────────────────────────
MC_SERVER_IP=yourserver.aternos.me
MC_SERVER_PORT=25565
# Set this to your server's Minecraft version, e.g. 1.21.1
# Plugin ViaVersion and ViaBackward if you want the bot to support other Minecraft versions.
MC_SERVER_VERSION=1.21.1

# ─── AFK Bot Account ───────────────────────────────────────
# Leave MC_PASSWORD empty for cracked/offline mode
MC_USERNAME=DiscoMineAFK
MC_PASSWORD=
MC_AUTH=offline

# ─── Status Channel ────────────────────────────────────────
# Right-click a Discord channel → Copy Channel ID
STATUS_CHANNEL_ID=your_channel_id_here

# ─── Auto bot-shutdown ─────────────────────────────────────
AUTO_SHUTDOWN_ENABLED=false
# Time to automatically shut down the bot
# Uses 24-hour HH:MM format (eg. 04:00)
AUTO_SHUTDOWN_TIME=04:00

# ─── Interleaving bypass method ────────────────────────────
# When enabled, the bot periodically disconnects from Minecraft and joins back
# This is to reset the account join counter to bypass kicks
INTERLEAVING_ENABLED=false

# How often the bot should perform an interleaving cycle
# Value is in hours, (eg: 3 = approximately every 3 hours)
INTERLEAVING_INTERVAL_HOURS=3
